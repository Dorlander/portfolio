# Настройки моста «учёт УТК -> LocalChat». Скопируйте в .env и заполните.

# Адрес сайта учёта (как его видит мост)
UCHET_URL=http://localhost:3000

# Адрес учёта для ЛЮДЕЙ (ссылки в сообщениях чата ведут на карточку акта).
# Укажите адрес, который открывается с рабочих ПК, например http://192.168.1.10:3000
UCHET_PUBLIC_URL=

# Адрес чата LocalChat
CHAT_URL=http://localhost:3780

# Бот: обычный пользователь чата. Зарегистрируйте его через окно
# регистрации чата (например логин uchet_bot) и добавьте в группу.
CHAT_BOT_USER=uchet_bot
CHAT_BOT_PASSWORD=

# Точное название группы, куда слать уведомления (бот должен в ней состоять)
CHAT_GROUP_NAME=УТК уведомления

# Как часто проверять журнал учёта, секунд
POLL_SECONDS=30
