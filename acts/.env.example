# Скопируйте в .env и заполните под свою установку.
# Все переменные необязательны, кроме DATABASE_URL.


DATABASE_URL=file:./db/custom.db

# Секрет для подписи сессионных cookie. Если не задан — генерируется
# и сохраняется в db/.auth-secret при первом запуске.
# AUTH_SECRET=

# Внешний адрес приложения для ссылок в уведомлениях.
# APP_URL=http://localhost:3000

# --- Синхронизация с таблицей ----------------------------------
# Путь к общему файлу журнала. Не задан — синхронизация выключена.
# SYNC_FILE=/data/Журнал.xlsx
# SYNC_INTERVAL_SECONDS=60

# --- Интеграция с чатом -------------------------
# Не заданы — интеграция выключена, учёт работает со входом по PIN.
# CHAT_URL          — адрес чата, по которому его видит сервер учёта
# CHAT_PUBLIC_URL   — адрес, по которому чат открывается у сотрудников
# CHAT_GROUP_ID     — id рабочей группы: членство в ней даёт доступ,
#                     роль в группе задаёт роль в учёте
# CHAT_GROUP_NAME   — название группы, показывается в тексте ошибок
# CHAT_URL=http://localchat:3780
# CHAT_PUBLIC_URL=http://localchat:3780
# CHAT_GROUP_ID=
# CHAT_GROUP_NAME=УТК

# --- Резервное копирование -------------------------------------------
# BACKUP_DIR=./db/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=30
# BACKUP_DISABLED=1

# --- Совместное редактирование через OnlyOffice (опционально) --------
# ONLYOFFICE_URL=
# ONLYOFFICE_INTERNAL_URL=
# ONLYOFFICE_JWT_SECRET=
# ONLYOFFICE_ALLOWED_HOSTS=

# --- Прочее -----------------------------------------------------------
# Папка для файловых логов (по умолчанию — временная папка системы).
# UCHET_LOG_DIR=
# Разрешить демо-сброс базы 
# ALLOW_DEMO_RESET=1
