# Настройки моста «учёт УТК -> Chat». Скопируйте в .env и заполните.

# Адрес сайта учёта
UCHET_URL=http://localhost:3000

# ссылки в сообщениях чата ведут на карточку акта
# Укажите адрес, который открывается с рабочих ПК
UCHET_PUBLIC_URL=

# Адрес чата 
CHAT_URL=http://localhost:3780

# Бот: обычный пользователь чата. Зарегистрируйте его через окно
# регистрации чата (например логин u_bot) и добавьте в группу.
CHAT_BOT_USER=u_bot
CHAT_BOT_PASSWORD=1234

# Точное название группы, куда слать уведомления (бот должен в ней состоять)
CHAT_GROUP_NAME=Уведомления

# Как часто проверять журнал учёта, секунд
POLL_SECONDS=10
